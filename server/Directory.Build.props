<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  
  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <Target Name="ForbidTestOnlyPackages"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(IsTestProject)' != 'true'">
    
    <ItemGroup>
      <_TestOnlyPackage Include="@(PackageVersion->WithMetadataValue('TestOnly', 'true'))" />
      <_TestOnlyNotReferenced Include="@(_TestOnlyPackage)" Exclude="@(PackageReference)" />
      <_ForbiddenTestPackage Include="@(_TestOnlyPackage)" Exclude="@(_TestOnlyNotReferenced)" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenTestPackage)' != ''" Code="PW0001"
           Text="$(MSBuildProjectName) references test-only package(s): @(_ForbiddenTestPackage). Reference them only from test projects (IsTestProject=true)." />
  </Target>
</Project>