UsosOAuth__ConsumerKey=your-usos-consumer-key
UsosOAuth__ConsumerSecret=your-usos-consumer-secret
UsosOAuth__HashingKey=your-64-bytes-length-hashing-key-for-user-usos-id
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=putwiki;Username=postgres;Password=password
Jwt__Secret=your-secret-key-min-32-bytes
# Access tokens expire after 15 minutes; refresh sessions expire after 7 days.
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
