# Copy to .env.local to override.

# Set to "false" to disable MSW mocks and use the real backend (proxied from /api to http://localhost:7278)
VITE_ENABLE_MOCKS=true

# Lifetime of the mocked JWT (auth_token cookie). Backend default is 1440 (24h). Set to 1 to test session expiration.
VITE_MOCK_TOKEN_TTL_MINUTES=1440
