{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun tsc -b && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.30",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-onboarding": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.9",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.2",
    "lint-staged": "^16.2.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
